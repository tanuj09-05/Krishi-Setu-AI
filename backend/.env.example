# Django Core Configuration
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
RENDER_EXTERNAL_HOSTNAME=

# Database Configuration (PostgreSQL on Render, or omit for SQLite in local dev)
DATABASE_URL=

# CORS Configuration (Production Frontend URLs, comma-separated)
CORS_ALLOWED_ORIGINS=

# CSRF Trusted Origins (Optional, comma-separated)
CSRF_TRUSTED_ORIGINS=

# JWT Configuration
JWT_SECRET_KEY=

# Security Header Overrides (Optional in production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
